TWIKIT_USERNAME=your_username
TWIKIT_EMAIL=you@example.com
TWIKIT_PASSWORD=your_password
# Optional: set true to skip password login and load TWIKIT_COOKIES_FILE directly.
TWIKIT_COOKIE_ONLY=false
# Optional: TOTP secret for 2FA accounts.
TWIKIT_TOTP_SECRET=
# Optional: defaults to .cache/twikit/cookies.json
TWIKIT_COOKIES_FILE=.cache/twikit/cookies.json
# Optional: defaults to en-US
TWIKIT_LANGUAGE=en-US
# Optional: browser TLS fingerprint for Cloudflare/X 403s, e.g. chrome124.
TWIKIT_IMPERSONATE=
# Optional: set false if login fails while solving X ui_metrics JavaScript.
TWIKIT_ENABLE_UI_METRICS=true
